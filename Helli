--// ========== SEX TOYS (Floor + Wall) ==========
local function removeToy()
	if rideConn then rideConn:Disconnect() rideConn = nil end
	if toyPart and toyPart.Parent then toyPart:Destroy() end
	toyPart = nil
	state.toyMode = "None"
	state.toyActive = false
	notify("Toy removed")
end

local function createToyModel(toyType)
	local toy = Instance.new("Part")
	toy.Name = "SexToy"
	toy.CanCollide = false
	toy.Massless = true
	toy.Anchored = true
	toy.Material = Enum.Material.SmoothPlastic
	toy.Color = Color3.fromRGB(255, 140, 170)

	if toyType == "Dildo" then
		toy.Size = Vector3.new(0.38, 1.55, 0.38)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Cylinder
		m.Parent = toy
	elseif toyType == "Vibrator" then
		toy.Size = Vector3.new(0.42, 0.95, 0.42)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = toy
	else
		toy.Size = Vector3.new(0.55, 0.65, 0.55)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = toy
	end
	return toy
end

local function placeToy(toyType, mode)
	if not getChar() then return end
	removeToy()

	local toy = createToyModel(toyType)
	toy.Parent = workspace

	local cam = workspace.CurrentCamera
	local unitRay = cam:ScreenPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {character}
	params.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 60, params)
	if result then
		if mode == "Floor" then
			toy.CFrame = CFrame.new(result.Position + Vector3.new(0, toy.Size.Y/2, 0))
		else
			toy.CFrame = CFrame.new(result.Position, result.Position + result.Normal) * CFrame.Angles(math.rad(90), 0, 0)
		end
	else
		toy.CFrame = root.CFrame * CFrame.new(0, -2.8, -2.5)
	end

	toyPart = toy
	state.toyMode = mode
	notify("Đã đặt " .. toyType .. " (" .. (mode == "Floor" and "Đất" or "Tường") .. ")")
end

local function startRide()
	if not toyPart or not getChar() or state.toyActive then return end
	state.toyActive = true
	stopPose()

	local baseCF = toyPart.CFrame
	local t = 0

	rideConn = RunService.RenderStepped:Connect(function(dt)
		if not character or not character.Parent or not toyPart then
			removeToy()
			return
		end
		t = t + dt

		if state.toyMode == "Floor" then
			local height = math.sin(t * 6.2) * 0.32 + 0.12
			local squatCF = baseCF * CFrame.new(0, 1.05 + height, 0) * CFrame.Angles(math.rad(-12), 0, 0)

			if isR15 then
				local upper = character:FindFirstChild("UpperTorso")
				local lower = character:FindFirstChild("LowerTorso")
				local lul = character:FindFirstChild("LeftUpperLeg")
				local rul = character:FindFirstChild("RightUpperLeg")
				if lower then lower.CFrame = squatCF end
				if upper then upper.CFrame = squatCF * CFrame.new(0, 0.65, 0) * CFrame.Angles(math.rad(8), 0, 0) end
				if lul then lul.CFrame = squatCF * CFrame.new(-0.4, -0.55, 0.1) * CFrame.Angles(math.rad(-78), math.rad(10), 0) end
				if rul then rul.CFrame = squatCF * CFrame.new(0.4, -0.55, 0.1) * CFrame.Angles(math.rad(-78), math.rad(-10), 0) end
			else
				local torso = character:FindFirstChild("Torso")
				local ll = character:FindFirstChild("Left Leg")
				local rl = character:FindFirstChild("Right Leg")
				if torso then torso.CFrame = squatCF end
				if ll then ll.CFrame = squatCF * CFrame.new(-0.5, -1, 0) * CFrame.Angles(math.rad(-82), 8, 0) end
				if rl then rl.CFrame = squatCF * CFrame.new(0.5, -1, 0) * CFrame.Angles(math.rad(-82), -8, 0) end
			end

		elseif state.toyMode == "Wall" then
			local press = math.sin(t * 5.8) * 0.16
			if isR15 then
				local upper = character:FindFirstChild("UpperTorso")
				local lower = character:FindFirstChild("LowerTorso")
				local lul = character:FindFirstChild("LeftUpperLeg")
				local rul = character:FindFirstChild("RightUpperLeg")
				local wallCF = baseCF * CFrame.new(0, 0.15, -0.75 + press) * CFrame.Angles(math.rad(58), 0, 0)
				if upper then upper.CFrame = wallCF end
				if lower then lower.CFrame = wallCF * CFrame.new(0, -0.7, 0.12) * CFrame.Angles(math.rad(18), 0, 0) end
				if lul then lul.CFrame = wallCF * CFrame.new(-0.45, -0.9, 0.2) * CFrame.Angles(math.rad(-28), math.rad(12), 0) end
				if rul then rul.CFrame = wallCF * CFrame.new(0.45, -0.9, 0.2) * CFrame.Angles(math.rad(-28), math.rad(-12), 0) end
			else
				local torso = character:FindFirstChild("Torso")
				local ll = character:FindFirstChild("Left Leg")
				local rl = character:FindFirstChild("Right Leg")
				local wallCF = baseCF * CFrame.new(0, 0.1, -0.7 + press) * CFrame.Angles(math.rad(62), 0, 0)
				if torso then torso.CFrame = wallCF end
				if ll then ll.CFrame = wallCF * CFrame.new(-0.5, -1.1, 0.2) * CFrame.Angles(math.rad(-32), 12, 0) end
				if rl then rl.CFrame = wallCF * CFrame.new(0.5, -1.1, 0.2) * CFrame.Angles(math.rad(-32), -12, 0) end
			end
		end
	end)
