--// ========== UTIL ==========
local function getChar()
	character = player.Character
	if not character then return false end
	humanoid = character:FindFirstChildOfClass("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
	torso = character:FindFirstChild("Torso")
	if not (humanoid and root and torso) then return false end
	if humanoid.RigType \~= Enum.HumanoidRigType.R6 then
		warn("[R34] Script này chỉ hỗ trợ R6!")
		return false
	end
	return true
end

local function notify(msg)
	print("[R34] " .. tostring(msg))
end

local function clearTable(t)
	for _, v in ipairs(t) do
		if typeof(v) == "Instance" and v.Parent then
			v:Destroy()
		end
	end
	table.clear(t)
end

local function zeroVel(part)
	if part and part:IsA("BasePart") then
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
end

--// ========== STRIP ==========
local function stripClothes()
	if not getChar() then return end
	for _, v in ipairs(character:GetDescendants()) do
		if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Clothing") then
			v:Destroy()
		end
	end
	pcall(function()
		local desc = humanoid:GetAppliedDescription()
		desc.Shirt = 0
		desc.Pants = 0
		desc.GraphicTShirt = 0
		humanoid:ApplyDescriptionReset(desc)
	end)
	state.stripped = true
	notify("Stripped")
end

--// ========== BODY PARTS (gần style video) ==========
local function createPart(name, size, c0, parent, color, meshScale)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color or Color3.fromRGB(255, 210, 195)
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.CastShadow = true

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = meshScale or Vector3.new(1, 1, 1)
	mesh.Parent = p

	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = c0
	w.Parent = p

	p.Parent = character
	return p, w
end

