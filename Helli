--// ========== PHYSICS ==========
local function setPhysics(on)
	if physConn then physConn:Disconnect() physConn = nil end
	state.physics = on
	if not on then
		notify("Physics OFF")
		return
	end
	notify("Physics ON | Power: " .. string.format("%.2f", state.physicsPower))
	physConn = RunService.RenderStepped:Connect(function()
		local t = tick()
		local pwr = state.physicsPower
		local function jiggle(list)
			for i = 1, #list, 2 do
				local part = list[i]
				local weld = list[i+1]
				if part and part.Parent and weld and weld:IsA("Weld") then
					weld.C0 = weld.C0:Lerp(weld.C0 * CFrame.new(
						math.sin(t * 8.5 + i) * pwr,
						math.cos(t * 6.8 + i) * pwr * 0.7,
						math.sin(t * 5.2 + i) * pwr * 0.35
					), 0.3)
				end
			end
		end
		if state.breast then jiggle(breastParts) end
		if state.butt then jiggle(buttParts) end
	end)
end

local function changePhysics(delta)
	state.physicsPower = math.clamp(state.physicsPower + delta, 0.01, 0.12)
	if state.physics then setPhysics(true) end
	notify("Physics power: " .. string.format("%.2f", state.physicsPower))
end

