--// ========== BETTER PHYSICS (Velocity + Spring style) ==========
local breastVel, buttVel = {}, {}
local function setPhysics(on)
	if physConn then physConn:Disconnect() physConn = nil end
	state.physics = on
	if not on then
		notify("Physics OFF")
		return
	end
	notify("Physics ON | Power: " .. string.format("%.2f", state.physicsPower))

	-- Reset velocities
	for i = 1, 8 do breastVel[i] = Vector3.zero end
	for i = 1, 8 do buttVel[i] = Vector3.zero end

	local lastRootPos = root and root.Position or Vector3.zero

	physConn = RunService.RenderStepped:Connect(function(dt)
		if not getChar() then return end
		dt = math.clamp(dt, 0, 0.05)
		local power = state.physicsPower

		local currentPos = root.Position
		local accel = (currentPos - lastRootPos) / math.max(dt, 0.001)
		lastRootPos = currentPos

		local function applyJiggle(parts, vels, baseMul)
			for i = 1, #parts, 2 do
				local part = parts[i]
				local weld = parts[i+1]
				if part and part.Parent and weld and weld:IsA("Weld") then
					local idx = math.ceil(i/2)
					local targetOffset = Vector3.new(
						math.sin(tick() * 4.2 + idx) * 0.015,
						math.cos(tick() * 3.6 + idx) * 0.012,
						0
					)

					-- Influence from movement
					local influence = accel * Vector3.new(0.004, 0.003, 0.002) * power * baseMul
					vels[idx] = (vels[idx] or Vector3.zero) * 0.88 + influence + targetOffset

					-- Soft spring back
					vels[idx] = vels[idx]:Lerp(Vector3.zero, 0.08)

					local offset = vels[idx]
					weld.C0 = weld.C0:Lerp(
						CFrame.new(offset.X, offset.Y, offset.Z) * CFrame.Angles(
							math.rad(offset.Y * 18),
							math.rad(offset.X * 12),
							0
						),
						0.35
					)
				end
			end
		end

		if state.breast then applyJiggle(breastParts, breastVel, 1.15) end
		if state.butt then applyJiggle(buttParts, buttVel, 1.0) end
	end)
end

local function changePhysics(delta)
	state.physicsPower = math.clamp(state.physicsPower + delta, 0.15, 1.4)
	if state.physics then setPhysics(true) end
	notify("Physics power: " .. string.format("%.2f", state.physicsPower))
end

--// ========== STABLE POSES (Motor6D based + root lock) ==========
local function stopPose()
	if poseConn then poseConn:Disconnect() poseConn = nil end
	state.pose = "None"

	pcall(function()
		if humanoid then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		-- Restore motors if we modified them
		for motor, data in pairs(originalMotors) do
			if motor and motor.Parent then
				motor.C0 = data.C0
				motor.C1 = data.C1
			end
		end
		table.clear(originalMotors)
	end)
	notify("Đã reset tư thế")
end

local function applyPose(name)
	if not getChar() then return end
	stopPose()

	-- Stop all animations
	pcall(function()
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				track:Stop(0)
			end
		end
	end)

	state.pose = name
	notify("Pose: " .. name)

	humanoid.PlatformStand = true
	zeroVelocity(root)

	poseConn = RunService.RenderStepped:Connect(function()
		if not character or not character.Parent or not root then
			stopPose()
			return
		end

		zeroVelocity(root)
		for _, part in ipairs(character:GetChildren()) do
			if part:IsA("BasePart") then
				zeroVelocity(part)
			end
		end

		-- Keep root stable
		local base = root.CFrame

		local function setMotor(jointName, c0)
			local motor = character:FindFirstChild(jointName, true)
			if motor and motor:IsA("Motor6D") then
				if not originalMotors[motor] then
					originalMotors[motor] = {C0 = motor.C0, C1 = motor.C1}
				end
				motor.C0 = c0
			end
		end

		if isR15 then
			if name == "Doggy" then
				setMotor("Waist", CFrame.new(0, 0.2, 0) * CFrame.Angles(math.rad(25), 0, 0))
				setMotor("Root", CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(-15), 0, 0))
				setMotor("LeftHip", CFrame.new(-0.4, -0.6, 0.2) * CFrame.Angles(math.rad(-35), math.rad(15), 0))
				setMotor("RightHip", CFrame.new(0.4, -0.6, 0.2) * CFrame.Angles(math.rad(-35), math.rad(-15), 0))
			elseif name == "Missionary" then
				setMotor("LeftHip", CFrame.new(-0.35, -0.1, 0.55) * CFrame.Angles(math.rad(-95), math.rad(20), 0))
				setMotor("RightHip", CFrame.new(0.35, -0.1, 0.55) * CFrame.Angles(math.rad(-95), math.rad(-20), 0))
			elseif name == "Cowgirl" then
				setMotor("LeftHip", CFrame.new(-0.5, -0.4, 0.05) * CFrame.Angles(math.rad(-55), math.rad(35), math.rad(5)))
				setMotor("RightHip", CFrame.new(0.5, -0.4, 0.05) * CFrame.Angles(math.rad(-55), math.rad(-35), math.rad(-5)))
			elseif name == "Reverse Cowgirl" then
				setMotor("LeftHip", CFrame.new(-0.5, -0.4, -0.1) * CFrame.Angles(math.rad(-50), math.rad(32), 0))
				setMotor("RightHip", CFrame.new(0.5, -0.4, -0.1) * CFrame.Angles(math.rad(-50), math.rad(-32), 0))
			elseif name == "Legs Up" then
				setMotor("LeftHip", CFrame.new(-0.3, 0.3, 0.65) * CFrame.Angles(math.rad(-125), math.rad(10), 0))
				setMotor("RightHip", CFrame.new(0.3, 0.3, 0.65) * CFrame.Angles(math.rad(-125), math.rad(-10), 0))
			elseif name == "Bent Over" then
				setMotor("Waist", CFrame.new(0, 0.1, 0.25) * CFrame.Angles(math.rad(55), 0, 0))
				setMotor("Root", CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(-20), 0, 0))
			elseif name == "All Fours" then
				setMotor("Waist", CFrame.new(0, 0.05, 0.3) * CFrame.Angles(math.rad(60), 0, 0))
				setMotor("LeftShoulder", CFrame.new(-0.7, 0.1, 0.5) * CFrame.Angles(math.rad(-70), 0, math.rad(20)))
				setMotor("RightShoulder", CFrame.new(0.7, 0.1, 0.5) * CFrame.Angles(math.rad(-70), 0, math.rad(-20)))
			elseif name == "Standing Spread" then
				setMotor("LeftHip", CFrame.new(-0.65, -0.85, 0) * CFrame.Angles(math.rad(-8), math.rad(28), 0))
				setMotor("RightHip", CFrame.new(0.65, -0.85, 0) * CFrame.Angles(math.rad(-8), math.rad(-28), 0))
			elseif name == "Squat" then
				setMotor("LeftHip", CFrame.new(-0.35, -0.65, 0.15) * CFrame.Angles(math.rad(-75), math.rad(10), 0))
				setMotor("RightHip", CFrame.new(0.35, -0.65, 0.15) * CFrame.Angles(math.rad(-75), math.rad(-10), 0))
			end
		else
			-- R6 simplified stable poses
			local torso = character:FindFirstChild("Torso")
			if not torso then return end

			if name == "Doggy" then
				torso.CFrame = base * CFrame.new(0, 0.1, 0) * CFrame.Angles(math.rad(45), 0, 0)
			elseif name == "Missionary" then
				-- Keep simple for R6 stability
			elseif name == "Bent Over" then
				torso.CFrame = base * CFrame.new(0, 0, 0.25) * CFrame.Angles(math.rad(65), 0, 0)
			elseif name == "All Fours" then
				torso.CFrame = base * CFrame.new(0, 0, 0.2) * CFrame.Angles(math.rad(70), 0, 0)
			end
		end
	end)
end

--// ========== IMPROVED SEX TOYS (No fling) ==========
local function removeToy()
	if rideConn then rideConn:Disconnect() rideConn = nil end
	if alignPos then alignPos:Destroy() alignPos = nil end
	if alignOri then alignOri:Destroy() alignOri = nil end
	if toyPart and toyPart.Parent then toyPart:Destroy() end
	toyPart = nil
	state.toyMode = "None"
	state.toyActive = false
	if humanoid then humanoid.PlatformStand = false end
	notify("Toy removed")
end

local function createToyModel(toyType)
	local toy = Instance.new("Part")
	toy.Name = "SexToy"
	toy.CanCollide = false
	toy.Massless = true
	toy.Anchored = true
	toy.Material = Enum.Material.SmoothPlastic
	toy.Color = Color3.fromRGB(255, 130, 160)
	toy.CastShadow = true

	local mesh = Instance.new("SpecialMesh")
	mesh.Parent = toy

	if toyType == "Dildo" then
		toy.Size = Vector3.new(0.42, 1.7, 0.42)
		mesh.MeshType = Enum.MeshType.Cylinder
		mesh.Scale = Vector3.new(1, 1, 1)
	elseif toyType == "Vibrator" then
		toy.Size = Vector3.new(0.48, 1.05, 0.48)
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(1, 1.1, 1)
	else
		toy.Size = Vector3.new(0.6, 0.7, 0.6)
		mesh.MeshType = Enum.MeshType.Sphere
	end
	return toy
end

local function placeToy(toyType, mode)
	if not getChar() then return end
	removeToy()

	local toy = createToyModel(toyType)
	toy.Parent = workspace

	local cam = workspace.CurrentCamera
	local unitRay = cam:ScreenPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {character}
	params.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 80, params)
	if result then
		if mode == "Floor" then
			toy.CFrame = CFrame.new(result.Position + Vector3.new(0, toy.Size.Y/2 + 0.05, 0))
		else
			toy.CFrame = CFrame.new(result.Position, result.Position + result.Normal) * CFrame.Angles(math.rad(90), 0, 0)
		end
	else
		toy.CFrame = root.CFrame * CFrame.new(0, -2.6, -2.8)
	end

	toyPart = toy
	state.toyMode = mode
	notify("Đã đặt " .. toyType .. " (" .. (mode == "Floor" and "Đất" or "Tường") .. ")")
end

local function startRide()
	if not toyPart or not getChar() or state.toyActive then return end
	state.toyActive = true
	stopPose()
	humanoid.PlatformStand = true

	-- Create AlignPosition to prevent flinging
	alignPos = Instance.new("AlignPosition")
	alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPos.MaxForce = 50000
	alignPos.MaxVelocity = 12
	alignPos.Responsiveness = 35
	alignPos.Attachment0 = Instance.new("Attachment", root)
	alignPos.Parent = root

	alignOri = Instance.new("AlignOrientation")
	alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOri.MaxTorque = 50000
	alignOri.Responsiveness = 25
	alignOri.Attachment0 = alignPos.Attachment0
	alignOri.Parent = root

	local baseCF = toyPart.CFrame
	local t = 0

	rideConn = RunService.RenderStepped:Connect(function(dt)
		if not character or not character.Parent or not toyPart or not root then
			removeToy()
			return
		end
		t = t + dt
		zeroVelocity(root)

		if state.toyMode == "Floor" then
			local height = math.sin(t * 5.8) * 0.28 + 0.15
			local target = baseCF * CFrame.new(0, 1.15 + height, 0) * CFrame.Angles(math.rad(-8), 0, 0)
			alignPos.Position = target.Position
			alignOri.CFrame = target
		elseif state.toyMode == "Wall" then
			local press = math.sin(t * 5.5) * 0.14
			local target = baseCF * CFrame.new(0, 0.2, -0.85 + press) * CFrame.Angles(math.rad(55), 0, 0)
			alignPos.Position = target.Position
			alignOri.CFrame = target
		end
	end)
end

