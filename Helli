--[[
	Script Name: Full-Detail R6 Sensual Actions Menu
	Target Rig: R6
	Description: Giao diện menu tối giản tích hợp đầy đủ 4 hành động R6 với độ chi tiết và độ mượt tối đa.
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- Khởi tạo ScreenGui tối giản
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "R6ActionMenu"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 230, 0, 300)
MainFrame.Position = UDim2.new(0, 50, 0, 150)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundTransparency = 1
Title.Text = "Menu Hành Động R6 (Chi Tiết)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 15
Title.Font = Enum.Font.SourceSansBold
Title.Parent = MainFrame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 8)
UIListLayout.Parent = MainFrame

local Padding = Instance.new("UIPadding")
Padding.PaddingTop = UDim.new(0, 45)
Padding.PaddingLeft = UDim.new(0, 10)
Padding.PaddingRight = UDim.new(0, 10)
Padding.Parent = MainFrame

local activeConnection = nil

local function stopCurrentAction()
	if activeConnection then
		activeConnection:Disconnect()
		activeConnection = nil
	end
	local humanoid = Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid.PlatformStand = false
		end)
	end
end

local function playAction(updateFunction)
	stopCurrentAction()
	Character = LocalPlayer.Character
	if not Character then return end
	
	local torso = Character:FindFirstChild("Torso")
	local leftLeg = Character:FindFirstChild("Left Leg")
	local rightLeg = Character:FindFirstChild("Right Leg")
	local leftArm = Character:FindFirstChild("Left Arm")
	local rightArm = Character:FindFirstChild("Right Arm")
	local rootPart = Character:FindFirstChild("HumanoidRootPart")
	local humanoid = Character:FindFirstChildOfClass("Humanoid")
	
	if not (torso and leftLeg and rightLeg and rootPart) then return end
	
	if humanoid then
		pcall(function()
			humanoid.PlatformStand = true
		end)
	end
	
	local startTime = tick()
	activeConnection = RunService.RenderStepped:Connect(function()
		if not Character or not Character.Parent then
			stopCurrentAction()
			return
		end
		local t = tick() - startTime
		updateFunction(t, rootPart, torso, leftLeg, rightLeg, leftArm, rightArm)
		
		for _, p in ipairs({torso, leftLeg, rightLeg, leftArm, rightArm}) do
			if p and p:IsA("BasePart") then
				p.AssemblyLinearVelocity = Vector3.zero
				p.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end)
end

local function createButton(name, actionFunc)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 14
	btn.Font = Enum.Font.SourceSans
	btn.Text = name
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn
	
	btn.MouseButton1Click:Connect(actionFunc)
	btn.Parent = MainFrame
end

-- 1. Ngồi Xổm (Giữ nguyên toàn bộ đa tầng nhịp sóng và biên độ chi tiết)
createButton("Ngồi Xổm", function()
	playAction(function(t, root, torso, lLeg, rLeg, lArm, rArm)
		local primaryBreath = math.sin(t * 3.2)
		local hipBounce = math.cos(t * 4.8) * 0.12
		local sideSway = math.sin(t * 2.1) * 0.08
		local microJiggle = math.cos(t * 8.5) * 0.02
		local rootCF = root.CFrame

		local torsoTargetCF = rootCF * CFrame.new(sideSway, -1.15 + hipBounce, -0.2) 
			* CFrame.Angles(math.rad(28 + primaryBreath * 3), math.rad(sideSway * 15), math.rad(sideSway * 10))
		torso.CFrame = torso.CFrame:Lerp(torsoTargetCF, 0.2)

		local leftLegTargetCF = rootCF * CFrame.new(-0.55, -1.55 + (hipBounce * 0.5), 0.35) 
			* CFrame.Angles(math.rad(-95 + primaryBreath * 2), math.rad(22 + microJiggle), math.rad(-12))
		lLeg.CFrame = lLeg.CFrame:Lerp(leftLegTargetCF, 0.2)

		local rightLegTargetCF = rootCF * CFrame.new(0.55, -1.55 + (hipBounce * 0.5), 0.35) 
			* CFrame.Angles(math.rad(-95 + primaryBreath * 2), math.rad(-22 - microJiggle), math.rad(12))
		rLeg.CFrame = rLeg.CFrame:Lerp(rightLegTargetCF, 0.2)

		if lArm then
			local leftArmTargetCF = rootCF * CFrame.new(-0.85, -0.7 + (primaryBreath * 0.04), 0.4) 
				* CFrame.Angles(math.rad(-45), math.rad(-30), math.rad(25 + microJiggle * 5))
			lArm.CFrame = lArm.CFrame:Lerp(leftArmTargetCF, 0.2)
		end

		if rArm then
			local rightArmTargetCF = rootCF * CFrame.new(0.85, -0.7 + (primaryBreath * 0.04), 0.4) 
				* CFrame.Angles(math.rad(-45), math.rad(30), math.rad(-25 - microJiggle * 5))
			rArm.CFrame = rArm.CFrame:Lerp(rightArmTargetCF, 0.2)
		end
	end)
end)

-- 2. Ngồi Giang Rộng Chân (Giữ nguyên toàn bộ hệ thống mở đùi và ngả lưng)
createButton("Ngồi Giang Rộng Chân", function()
	playAction(function(t, root, torso, lLeg, rLeg, lArm, rArm)
		local breathCycle = math.sin(t * 2.8)
		local torsoSway = math.cos(t * 1.9) * 0.05
		local hipSway = math.sin(t * 3.5) * 0.04
		local microJiggle = math.cos(t * 7.2) * 0.015
		local rootCF = root.CFrame

		local torsoTargetCF = rootCF * CFrame.new(hipSway, -1.35 + (torsoSway * 0.5), -0.1) 
			* CFrame.Angles(math.rad(-15 + breathCycle * 2), math.rad(hipSway * 10), math.rad(0))
		torso.CFrame = torso.CFrame:Lerp(torsoTargetCF, 0.2)

		local leftLegTargetCF = rootCF * CFrame.new(-1.1 + hipSway, -1.25, 0.65) 
			* CFrame.Angles(math.rad(-25), math.rad(65 + breathCycle * 1.5), math.rad(-35))
		lLeg.CFrame = lLeg.CFrame:Lerp(leftLegTargetCF, 0.2)

		local rightLegTargetCF = rootCF * CFrame.new(1.1 + hipSway, -1.25, 0.65) 
			* CFrame.Angles(math.rad(-25), math.rad(-65 - breathCycle * 1.5), math.rad(35))
		rLeg.CFrame = rLeg.CFrame:Lerp(rightLegTargetCF, 0.2)

		if lArm then
			local leftArmTargetCF = rootCF * CFrame.new(-1.0, -0.9, -0.4) 
				* CFrame.Angles(math.rad(-30), math.rad(-45), math.rad(-40 + microJiggle * 5))
			lArm.CFrame = lArm.CFrame:Lerp(leftArmTargetCF, 0.2)
		end

		if rArm then
			local rightArmTargetCF = rootCF * CFrame.new(1.0, -0.9, -0.4) 
				* CFrame.Angles(math.rad(-30), math.rad(45), math.rad(40 - microJiggle * 5))
			rArm.CFrame = rArm.CFrame:Lerp(rightArmTargetCF, 0.2)
		end
	end)
end)

-- 3. Cúi Người Chổng Mông (Giữ nguyên toàn bộ góc gập và độ nâng hông)
createButton("Cúi Người Chổng Mông", function()
	playAction(function(t, root, torso, lLeg, rLeg, lArm, rArm)
		local primaryBreath = math.sin(t * 3.0)
		local hipRhythm = math.cos(t * 4.2) * 0.08
		local sideSway = math.sin(t * 2.0) * 0.05
		local microJiggle = math.cos(t * 8.0) * 0.02
		local rootCF = root.CFrame

		local torsoTargetCF = rootCF * CFrame.new(sideSway, -0.65 + hipRhythm, -0.85) 
			* CFrame.Angles(math.rad(78 + primaryBreath * 2), math.rad(sideSway * 10), math.rad(sideSway * 15))
		torso.CFrame = torso.CFrame:Lerp(torsoTargetCF, 0.2)

		local leftLegTargetCF = rootCF * CFrame.new(-0.6, -1.55, 0.25) 
			* CFrame.Angles(math.rad(-65 + primaryBreath * 1.5), math.rad(15), math.rad(-10))
		lLeg.CFrame = lLeg.CFrame:Lerp(leftLegTargetCF, 0.2)

		local rightLegTargetCF = rootCF * CFrame.new(0.6, -1.55, 0.25) 
			* CFrame.Angles(math.rad(-65 + primaryBreath * 1.5), math.rad(-15), math.rad(10))
		rLeg.CFrame = rLeg.CFrame:Lerp(rightLegTargetCF, 0.2)

		if lArm then
			local leftArmTargetCF = rootCF * CFrame.new(-0.85, -1.1, 0.7) 
				* CFrame.Angles(math.rad(-75), math.rad(-20), math.rad(-30 + microJiggle * 5))
			lArm.CFrame = lArm.CFrame:Lerp(leftArmTargetCF, 0.2)
		end

		if rArm then
			local rightArmTargetCF = rootCF * CFrame.new(0.85, -1.1, 0.7) 
				* CFrame.Angles(math.rad(-75), math.rad(20), math.rad(30 - microJiggle * 5))
			rArm.CFrame = rArm.CFrame:Lerp(rightArmTargetCF, 0.2)
		end
	end)
end)

-- 4. Nằm Ngửa Giang Chân (Giữ nguyên toàn bộ thông số nằm ngửa chi tiết)
createButton("Nằm Ngửa Giang Chân", function()
	playAction(function(t, root, torso, lLeg, rLeg, lArm, rArm)
		local breath = math.sin(t * 3.0) * 0.05
		local rootCF = root.CFrame

		local torsoTargetCF = rootCF * CFrame.new(0, -2.4 + breath, 0) 
			* CFrame.Angles(math.rad(-90), math.rad(0), math.rad(0))
		torso.CFrame = torso.CFrame:Lerp(torsoTargetCF, 0.2)

		local leftLegTargetCF = rootCF * CFrame.new(-0.95, -1.5, -0.6) 
			* CFrame.Angles(math.rad(-40), math.rad(55), math.rad(-30))
		lLeg.CFrame = lLeg.CFrame:Lerp(leftLegTargetCF, 0.2)

		local rightLegTargetCF = rootCF * CFrame.new(0.95, -1.5, -0.6) 
			* CFrame.Angles(math.rad(-40), math.rad(-55), math.rad(30))
		rLeg.CFrame = rLeg.CFrame:Lerp(rightLegTargetCF, 0.2)

		if lArm then
			local leftArmTargetCF = rootCF * CFrame.new(-1.2, -1.9, -0.2) 
				* CFrame.Angles(math.rad(-80), math.rad(-20), math.rad(-45))
			lArm.CFrame = lArm.CFrame:Lerp(leftArmTargetCF, 0.2)
		end

		if rArm then
			local rightArmTargetCF = rootCF * CFrame.new(1.2, -1.9, -0.2) 
				* CFrame.Angles(math.rad(-80), math.rad(20), math.rad(45))
			rArm.CFrame = rArm.CFrame:Lerp(rightArmTargetCF, 0.2)
		end
	end)
end)

