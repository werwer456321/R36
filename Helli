		local currentY = startY + (targetY - startY) * ease

		-- Nhấp nhẹ sau khi ngồi xong
		local bob = 0
		if progress >= 1 then
			bob = math.sin((t - 1.8) * 5.5) * 0.28
		end

		root.CFrame = CFrame.new(toyModel.PrimaryPart.Position.X, currentY + bob, toyModel.PrimaryPart.Position.Z)
			* CFrame.Angles(0, root.CFrame.LookVector.Y, 0)

		-- Ép tư thế ngồi xổm
		if isR15 then
			-- R15 sẽ được applyPose hỗ trợ thêm nếu cần
		else
			local leftLeg = character:FindFirstChild("Left Leg")
			local rightLeg = character:FindFirstChild("Right Leg")
			if leftLeg then leftLeg.CFrame = root.CFrame * CFrame.new(-0.5, -1.3, 0.15) * CFrame.Angles(math.rad(100), 0, math.rad(-15)) end
			if rightLeg then rightLeg.CFrame = root.CFrame * CFrame.new(0.5, -1.3, 0.15) * CFrame.Angles(math.rad(100), 0, math.rad(15)) end
		end
	end)

	notify("Bắt đầu ngồi xổm + rên")
end

