--// ========== PHYSICS ==========
local function setPhysics(on)
	if physConn then physConn:Disconnect() physConn = nil end
	state.physics = on
	if not on then notify("Physics OFF") return end

	notify("Physics ON")
	local t = 0
	physConn = RunService.RenderStepped:Connect(function(dt)
		t = t + dt
		local function jiggle(parts, power)
			for i = 1, #parts, 2 do
				local part = parts[i]
				local weld = parts[i+1]
				if part and weld and weld:IsA("Weld") then
					local offset = CFrame.new(
						math.sin(t * 5.5 + i) * 0.04 * power,
						math.cos(t * 4.2 + i) * 0.03 * power,
						math.sin(t * 3.8 + i) * 0.02 * power
					)
					weld.C0 = weld.C0:Lerp(weld.C0 * offset, 0.25)
				end
			end
		end
		if state.breast then jiggle(breastParts, 1.1) end
		if state.butt then jiggle(buttParts, 1.0) end
	end)
end

--// ========== POSES (R6 only - ổn định) ==========
local function stopPose()
	if poseConn then poseConn:Disconnect() poseConn = nil end
	state.pose = "None"
	pcall(function()
		if humanoid then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	notify("Reset tư thế")
end

local function applyPose(name)
	if not getChar() then return end
	stopPose()

	-- Dừng animation
	pcall(function()
		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
	end)

	state.pose = name
	humanoid.PlatformStand = true
	notify("Pose: " .. name)

	poseConn = RunService.RenderStepped:Connect(function()
		if not character or not character.Parent or not root or not torso then
			stopPose()
			return
		end

		zeroVel(root)
		zeroVel(torso)
		for _, part in ipairs(character:GetChildren()) do
			if part:IsA("BasePart") then zeroVel(part) end
		end

		local base = root.CFrame
		local ll = character:FindFirstChild("Left Leg")
		local rl = character:FindFirstChild("Right Leg")
		local la = character:FindFirstChild("Left Arm")
		local ra = character:FindFirstChild("Right Arm")

		if name == "Doggy" then -- Bò
			torso.CFrame = base * CFrame.new(0, 0.15, 0) * CFrame.Angles(math.rad(55), 0, 0)
			if ll then ll.CFrame = base * CFrame.new(-0.5, -1.0, 0.35) * CFrame.Angles(math.rad(-40), math.rad(15), 0) end
			if rl then rl.CFrame = base * CFrame.new(0.5, -1.0, 0.35) * CFrame.Angles(math.rad(-40), math.rad(-15), 0) end
			if la then la.CFrame = base * CFrame.new(-1.0, 0.2, 0.6) * CFrame.Angles(math.rad(-70), 0, math.rad(25)) end
			if ra then ra.CFrame = base * CFrame.new(1.0, 0.2, 0.6) * CFrame.Angles(math.rad(-70), 0, math.rad(-25)) end

		elseif name == "Squat" then -- Ngồi xổm
			torso.CFrame = base * CFrame.new(0, -0.3, 0) * CFrame.Angles(math.rad(10), 0, 0)
			if ll then ll.CFrame = base * CFrame.new(-0.45, -0.9, 0.25) * CFrame.Angles(math.rad(-85), math.rad(12), 0) end
			if rl then rl.CFrame = base * CFrame.new(0.45, -0.9, 0.25) * CFrame.Angles(math.rad(-85), math.rad(-12), 0) end

		elseif name == "Sit" then -- Ngồi xuống
			torso.CFrame = base * CFrame.new(0, -0.7, 0) * CFrame.Angles(math.rad(5), 0, 0)
			if ll then ll.CFrame = base * CFrame.new(-0.4, -0.5, 0.7) * CFrame.Angles(math.rad(-90), math.rad(10), 0) end
			if rl then rl.CFrame = base * CFrame.new(0.4, -0.5, 0.7) * CFrame.Angles(math.rad(-90), math.rad(-10), 0) end

		elseif name == "Spread" then -- Dang rộng chân
			torso.CFrame = base * CFrame.new(0, 0, 0)
			if ll then ll.CFrame = base * CFrame.new(-0.85, -1.0, 0) * CFrame.Angles(math.rad(-5), math.rad(40), 0) end
			if rl then rl.CFrame = base * CFrame.new(0.85, -1.0, 0) * CFrame.Angles(math.rad(-5), math.rad(-40), 0) end
		end
	end)
end

--// ========== SEX TOY (hình dương vật) ==========
local function removeToy()
	if rideConn then rideConn:Disconnect() rideConn = nil end
	if moanSound then
		moanSound:Stop()
		moanSound:Destroy()
		moanSound = nil
	end
	if toyPart and toyPart.Parent then toyPart:Destroy() end
	toyPart = nil
	state.toyActive = false
	if humanoid then humanoid.PlatformStand = false end
	notify("Toy removed")
end

local function createDildo()
	local toy = Instance.new("Part")
	toy.Name = "SexToy"
	toy.Size = Vector3.new(0.45, 1.8, 0.45)
	toy.Color = Color3.fromRGB(255, 160, 170)
	toy.Material = Enum.Material.SmoothPlastic
	toy.CanCollide = false
	toy.Anchored = true
	toy.CastShadow = true

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Cylinder
	mesh.Parent = toy

	-- Đầu dương vật
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(0.55, 0.55, 0.55)
	head.Color = Color3.fromRGB(255, 140, 155)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Anchored = true
	head.Parent = toy

	local headMesh = Instance.new("SpecialMesh")
	headMesh.MeshType = Enum.MeshType.Sphere
	headMesh.Parent = head

	local weld = Instance.new("Weld")
	weld.Part0 = toy
	weld.Part1 = head
	weld.C0 = CFrame.new(0, 0.95, 0)
	weld.Parent = head

	return toy
end

local function placeToy()
	if not getChar() then return end
	removeToy()

	local toy = createDildo()
	toy.Parent = workspace

	local cam = workspace.CurrentCamera
	local unitRay = cam:ScreenPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {character}
	params.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 70, params)
	if result then
		toy.CFrame = CFrame.new(result.Position + Vector3.new(0, 0.95, 0))
	else
		toy.CFrame = root.CFrame * CFrame.new(0, -2.5, -2.5)
	end

	toyPart = toy
	notify("Đã đặt Dildo")
end

local function startRide()
	if not toyPart or not getChar() or state.toyActive then return end
	state.toyActive = true
	stopPose()
	humanoid.PlatformStand = true

	-- Tiếng rên (bạn có thể thay SoundId khác)
	moanSound = Instance.new("Sound")
	moanSound.SoundId = "rbxassetid://9048376835" -- tiếng rên mẫu (có thể đổi)
	moanSound.Volume = 0.7
	moanSound.Looped = true
	moanSound.Parent = root
	moanSound:Play()

	local baseCF = toyPart.CFrame
	local t = 0

	rideConn = RunService.RenderStepped:Connect(function(dt)
		if not character or not character.Parent or not toyPart or not root then
			removeToy()
			return
		end
		t = t + dt
		zeroVel(root)
		zeroVel(torso)

		local height = math.sin(t * 6.5) * 0.32 + 0.15
		local target = baseCF * CFrame.new(0, 1.25 + height, 0) * CFrame.Angles(math.rad(-12), 0, 0)

		root.CFrame = target
		torso.CFrame = target * CFrame.new(0, 0.5, 0)

		local ll = character:FindFirstChild("Left Leg")
		local rl = character:FindFirstChild("Right Leg")
		if ll then ll.CFrame = target * CFrame.new(-0.45, -0.7, 0.15) * CFrame.Angles(math.rad(-75), 10, 0) end
		if rl then rl.CFrame = target * CFrame.new(0.45, -0.7, 0.15) * CFrame.Angles(math.rad(-75), -10, 0) end
	end)
end

