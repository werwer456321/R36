	sound.Looped = true
	sound.Parent = root
	sound:Play()

	local t = 0
	local startY = root.Position.Y
	local targetY = toyModel.PrimaryPart.Position.Y + 1.6

	rideConn = RunService.RenderStepped:Connect(function(dt)
		if not getChar() or not toyModel then return end
		t = t + dt
		zeroVel()

		-- Ngồi xổm từ từ (ease)
		local progress = math.clamp(t / 1.8, 0, 1) -- 1.8 giây ngồi xuống
