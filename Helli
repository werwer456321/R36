-- ====================== COMBAT ======================
local slapAuraStopper

CombatTab:AddToggle({
    Name = "Slap Aura",
    Default = false,
    Callback = function(state)
        if state then
            local success, result = pcall(function()
                return loadstring(game:HttpGet("https://raw.githubusercontent.com/TheWExploiter/Slap-Battles-TP/refs/heads/main/slapaura.lua"))()
            end)
            if success then
                slapAuraStopper = result
            else
                OrionLib:MakeNotification({
                    Name = "Lỗi",
                    Content = "Slap Aura script đã chết",
                    Time = 3
                })
            end
        else
            if slapAuraStopper then
                pcall(slapAuraStopper)
            end
        end
    end
})

