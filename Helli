--// ========== UTILITIES ==========
local function getChar()
	character = player.Character
	if not character then return false end
	humanoid = character:FindFirstChildOfClass("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) then return false end
	isR15 = humanoid.RigType == Enum.HumanoidRigType.R15
	return true
end

local function notify(msg)
	print("[R34] " .. tostring(msg))
end

local function clearTable(t)
	for _, v in ipairs(t) do
		if typeof(v) == "Instance" and v.Parent then
			v:Destroy()
		end
	end
	table.clear(t)
end

--// ========== STRIP ==========
local function stripClothes()
	if not getChar() then return end
	for _, v in ipairs(character:GetDescendants()) do
		if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Clothing") then
			v:Destroy()
		end
	end
	pcall(function()
		local desc = humanoid:GetAppliedDescription()
		desc.Shirt = 0
		desc.Pants = 0
		desc.GraphicTShirt = 0
		humanoid:ApplyDescriptionReset(desc)
	end)
	state.stripped = true
	notify("Stripped")
end

--// ========== BODY PARTS ==========
local function createPart(name, size, c0, parent, color)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color or Color3.fromRGB(255, 210, 190)
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.CastShadow = true

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1, 1)
	mesh.Parent = p

	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = c0
	w.Parent = p

	p.Parent = character
	return p, w
end

local function toggleBreast()
	if not getChar() then return end
	if state.breast then
		clearTable(breastParts)
		state.breast = false
		notify("Breasts OFF")
	else
		local parent = isR15 and character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		if not parent then return end
		local l, w1 = createPart("LBreast", Vector3.new(1.2, 1.1, 1.0), CFrame.new(-0.6, 0.45, -0.65), parent)
		local r, w2 = createPart("RBreast", Vector3.new(1.2, 1.1, 1.0), CFrame.new(0.6, 0.45, -0.65), parent)
		breastParts = {l, r, w1, w2}
		state.breast = true
		notify("Breasts ON")
	end
end

local function toggleButt()
	if not getChar() then return end
	if state.butt then
		clearTable(buttParts)
		state.butt = false
		notify("Butt OFF")
	else
		local parent = isR15 and character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
		if not parent then return end
		local l, w1 = createPart("LButt", Vector3.new(1.3, 1.2, 1.1), CFrame.new(-0.5, -0.5, 0.75), parent, Color3.fromRGB(255, 195, 180))
		local r, w2 = createPart("RButt", Vector3.new(1.3, 1.2, 1.1), CFrame.new(0.5, -0.5, 0.75), parent, Color3.fromRGB(255, 195, 180))
		buttParts = {l, r, w1, w2}
		state.butt = true
