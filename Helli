-- Rule34 Executor Script (Improved v2)
-- Client-Only | R6 + R15 | English code + Vietnamese menu
-- Fixed: Better body models, real-ish physics, stable poses, no-fling toys

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character, humanoid, root, animator
local isR15 = false

local state = {
	stripped = false,
	breast = false,
	butt = false,
	physics = false,
	physicsPower = 0.6,
	pose = "None",
	toyMode = "None",
	toyActive = false
}

local breastParts, buttParts = {}, {}
local poseConn, physConn, rideConn = nil, nil, nil
local toyPart, alignPos, alignOri = nil, nil, nil
local gui, mainFrame
local originalMotors = {}

--// ========== UTILITIES ==========
local function getChar()
	character = player.Character
	if not character then return false end
	humanoid = character:FindFirstChildOfClass("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
	animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not (humanoid and root) then return false end
	isR15 = humanoid.RigType == Enum.HumanoidRigType.R15
	return true
end

local function notify(msg)
	print("[R34] " .. tostring(msg))
end

local function clearTable(t)
	for _, v in ipairs(t) do
		if typeof(v) == "Instance" and v.Parent then
			v:Destroy()
		end
	end
	table.clear(t)
end

local function zeroVelocity(part)
	if part and part:IsA("BasePart") then
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end
end

--// ========== STRIP ==========
local function stripClothes()
	if not getChar() then return end
	for _, v in ipairs(character:GetDescendants()) do
		if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Clothing") or v:IsA("Accessory") then
			if not (v:IsA("Accessory") and v.Name:lower():find("hair")) then
				v:Destroy()
			end
		end
	end
	pcall(function()
		local desc = humanoid:GetAppliedDescription()
		desc.Shirt = 0
		desc.Pants = 0
		desc.GraphicTShirt = 0
		humanoid:ApplyDescriptionReset(desc)
	end)
	state.stripped = true
	notify("Stripped")
end

--// ========== BETTER BODY PARTS ==========
local function createBodyPart(name, size, c0, parent, color, meshScale)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color or Color3.fromRGB(255, 205, 180)
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.CastShadow = true
	p.Transparency = 0

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = meshScale or Vector3.new(1, 1, 1)
	mesh.Parent = p

	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = c0
	w.Parent = p

	p.Parent = character
	return p, w
end

local function toggleBreast()
	if not getChar() then return end
	if state.breast then
		clearTable(breastParts)
		state.breast = false
		notify("Breasts OFF")
	else
		local parent = isR15 and character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		if not parent then return end

		-- Main breasts (larger + better shape)
		local l, w1 = createBodyPart("LBreast", Vector3.new(1.35, 1.25, 1.15), CFrame.new(-0.55, 0.42, -0.72), parent, nil, Vector3.new(1.05, 0.95, 1.0))
		local r, w2 = createBodyPart("RBreast", Vector3.new(1.35, 1.25, 1.15), CFrame.new(0.55, 0.42, -0.72), parent, nil, Vector3.new(1.05, 0.95, 1.0))

		-- Soft under + side volume for better shape
		local l2, w3 = createBodyPart("LBreastSoft", Vector3.new(1.1, 0.7, 0.9), CFrame.new(-0.48, 0.05, -0.55), parent, Color3.fromRGB(255, 195, 170), Vector3.new(1, 0.7, 0.9))
		local r2, w4 = createBodyPart("RBreastSoft", Vector3.new(1.1, 0.7, 0.9), CFrame.new(0.48, 0.05, -0.55), parent, Color3.fromRGB(255, 195, 170), Vector3.new(1, 0.7, 0.9))

		breastParts = {l, r, l2, r2, w1, w2, w3, w4}
		state.breast = true
		notify("Breasts ON (Improved)")
	end
end

local function toggleButt()
	if not getChar() then return end
	if state.butt then
		clearTable(buttParts)
		state.butt = false
		notify("Butt OFF")
	else
		local parent = isR15 and character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
		if not parent then return end

		local l, w1 = createBodyPart("LButt", Vector3.new(1.45, 1.35, 1.25), CFrame.new(-0.48, -0.55, 0.78), parent, Color3.fromRGB(255, 190, 170), Vector3.new(1.05, 1.0, 1.0))
		local r, w2 = createBodyPart("RButt", Vector3.new(1.45, 1.35, 1.25), CFrame.new(0.48, -0.55, 0.78), parent, Color3.fromRGB(255, 190, 170), Vector3.new(1.05, 1.0, 1.0))

		-- Soft lower volume
