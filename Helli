BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = SpreadActionBtn
SpreadActionBtn.Parent = MainFrame

local activeSpreadConnection = nil

local function StopSpreadAction()
	if activeSpreadConnection then
		activeSpreadConnection:Disconnect()
		activeSpreadConnection = nil
	end
	local hum = Character:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.PlatformStand = false end) end
	SpreadActionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 180)
	SpreadActionBtn.Text = "Bắt Đầu Ngồi Giang Rộng Chân"
end

local function PlaySpreadAction()
	if activeSpreadConnection then
		StopSpreadAction()
		return
	end
	
	Character = LocalPlayer.Character
	if not Character then return end
	
	local torso = Character:FindFirstChild("Torso")
	local leftLeg = Character:FindFirstChild("Left Leg")
	local rightLeg = Character:FindFirstChild("Right Leg")
	local leftArm = Character:FindFirstChild("Left Arm")
	local rightArm = Character:FindFirstChild("Right Arm")
	local rootPart = Character:FindFirstChild("HumanoidRootPart")
	local humanoid = Character:FindFirstChildOfClass("Humanoid")
	
	if not (torso and leftLeg and rightLeg and rootPart) then return end
	if humanoid then pcall(function() humanoid.PlatformStand = true end) end
	
	local lockedRootCF = CFrame.new(rootPart.Position) * CFrame.Angles(0, select(2, rootPart.CFrame:ToOrientation()))
	local configData = ActionModule.GetDetailedSpreadPoseData()
	local startTime = tick()
	
	SpreadActionBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
	SpreadActionBtn.Text = "Dừng / Đứng Lên"
	
	activeSpreadConnection = RunService.RenderStepped:Connect(function()
		if not Character or not Character.Parent then 
			StopSpreadAction() 
			return 
		end
		
		local t = tick() - startTime
		local cfg = configData.ConfigurationParameters
		local b = math.sin(t * cfg.BreathingFrequency)
		local sw = math.cos(t * cfg.SwayFrequency) * cfg.SwayAmplitude
		local hs = math.sin(t * 3.5) * 0.04
		
		torso.CFrame = torso.CFrame:Lerp(lockedRootCF * CFrame.new(hs, -1.35 + (sw * 0.5), -0.1) * CFrame.Angles(math.rad(-15 + b * 2), math.rad(hs * 10), math.rad(0)), cfg.InterpolationSpeed)
		leftLeg.CFrame = leftLeg.CFrame:Lerp(lockedRootCF * CFrame.new(-1.1 + hs, -1.25, 0.65) * CFrame.Angles(math.rad(-25), math.rad(65 + b * 1.5), math.rad(-35)), cfg.InterpolationSpeed)
		rightLeg.CFrame = rightLeg.CFrame:Lerp(lockedRootCF * CFrame.new(1.1 + hs, -1.25, 0.65) * CFrame.Angles(math.rad(-25), math.rad(-65 - b * 1.5), math.rad(35)), cfg.InterpolationSpeed)
		
		if leftArm then 
			leftArm.CFrame = leftArm.CFrame:Lerp(lockedRootCF * CFrame.new(-1.0, -0.9, -0.4) * CFrame.Angles(math.rad(-30), math.rad(-45), math.rad(-40)), cfg.InterpolationSpeed) 
		end
		if rightArm then 
			rightArm.CFrame = rightArm.CFrame:Lerp(lockedRootCF * CFrame.new(1.0, -0.9, -0.4) * CFrame.Angles(math.rad(-30), math.rad(45), math.rad(40)), cfg.InterpolationSpeed) 
		end
		
		for _, p in ipairs({torso, leftLeg, rightLeg, leftArm, rightArm}) do
			if p and p:IsA("BasePart") then
				p.AssemblyLinearVelocity = Vector3.zero
				p.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end)
end

SpreadActionBtn.MouseButton1Click:Connect(PlaySpreadAction)
