--// ========== CREATE PART ==========
local function createPart(name, size, c0, parent, color, meshScale, meshType)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.CastShadow = true
	p.Transparency = 0

	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = meshType or Enum.MeshType.Sphere
	mesh.Scale = meshScale or Vector3.new(1, 1, 1)
	mesh.Parent = p

	local w = Instance.new("Weld")
	w.Part0 = parent
	w.Part1 = p
	w.C0 = c0
	w.Parent = p

	p.Parent = character
	return p, w
end

