--// ========== UTIL ==========
local function getChar()
	character = player.Character
	if not character then return false end
	humanoid = character:FindFirstChildOfClass("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
	torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	if not (humanoid and root and torso) then return false end
	isR15 = humanoid.RigType == Enum.HumanoidRigType.R15
	return true
end

local function notify(msg)
	print("[R34] " .. tostring(msg))
end

local function clearTable(t)
	for _, v in ipairs(t) do
		if typeof(v) == "Instance" and v.Parent then
			v:Destroy()
		end
	end
	table.clear(t)
end

local function getSkinColor()
	-- Ưu tiên BodyColors, fallback Torso
	local bc = character:FindFirstChildOfClass("BodyColors")
	if bc then
		return bc.TorsoColor3
	end
	return torso.Color
end

local function zeroVel()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

