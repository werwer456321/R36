-- ========== FIX CHỒNG NGỰC & QUẦN ÁO ==========
task.spawn(function()
    local player = game.Players.LocalPlayer
    local UIS = game:GetService("UserInputService")

    local function cleanBreasts(char, isNude)
        if not char then return end

        local breastParts = {}
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("MeshPart") then
                local name = string.lower(v.Name)
                if name:find("breast") or name:find("boob") or name:find("nipple") 
                or name:find("areola") or name:find("breastsroot") or name:find("breasttexture") then
                    table.insert(breastParts, v)
                end
            end
        end

        if isNude then
            -- Khi khỏa thân: chỉ giữ 1 bộ ngực sạch, xóa phần trùng
            local kept = false
            for _, part in ipairs(breastParts) do
                if not kept and (part.Name:find("Right") or part.Name:find("Left") or part.Name:find("BreastsRoot")) then
                    part.Transparency = 0
                    part.LocalTransparencyModifier = 0
                    kept = true
                else
                    -- Ẩn phần bị trùng
                    part.Transparency = 1
                    part.LocalTransparencyModifier = 1
                end
            end
        else
            -- Khi có quần áo: ẩn hết ngực custom để tránh lộ
            for _, part in ipairs(breastParts) do
                part.Transparency = 1
                part.LocalTransparencyModifier = 1
            end
        end
    end

    -- Theo dõi trạng thái nude
    local isCurrentlyNude = false

    -- Bắt phím C (cả từ nút O)
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.C then
            task.wait(0.15) -- đợi ClemonRC xử lý xong
            isCurrentlyNude = not isCurrentlyNude
            if player.Character then
                cleanBreasts(player.Character, isCurrentlyNude)
            end
        end
    end)

    -- Chạy lần đầu
    if player.Character then
        task.wait(2)
        cleanBreasts(player.Character, false)
    end

    player.CharacterAdded:Connect(function(char)
        task.wait(2.2)
        isCurrentlyNude = false
        cleanBreasts(char, false)
    end)
end)

-- ====================== NÚT O (NHỎ + ẤN 2 LẦN) ======================
loadstring([[
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if playerGui:FindFirstChild("SimpleCButton") then
    playerGui.SimpleCButton:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SimpleCButton"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

local button = Instance.new("TextButton")
button.Name = "OButton"
button.Size = UDim2.new(0, 40, 0, 40)
button.Position = UDim2.new(0.87, 0, 0.77, 0)
button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
button.Text = "O"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextScaled = true
button.Font = Enum.Font.GothamBold
button.BorderSizePixel = 0
button.Active = true
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 9)
corner.Parent = button

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(70, 150, 255)
stroke.Parent = button

local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local originalPos = button.Position
local lastClickTime = 0
local clickCount = 0
local DOUBLE_CLICK_TIME = 0.32

local function setPressed(pressed)
    if pressed then
        button.BackgroundColor3 = Color3.fromRGB(0, 95, 210)
        button.TextColor3 = Color3.fromRGB(255, 255, 130)
        button.Position = originalPos + UDim2.new(0, 0, 0, 3)
    else
        button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.Position = originalPos
    end
end

button.MouseButton1Click:Connect(function()
    local now = tick()
    if now - lastClickTime <= DOUBLE_CLICK_TIME then
        clickCount += 1
    else
        clickCount = 1
    end
    lastClickTime = now

    if clickCount >= 2 then
        clickCount = 0
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.C, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.C, false, game)

        setPressed(true)
        task.delay(0.11, function()
            setPressed(false)
        end)
    end
end)

-- Kéo nút
local dragging = false
local dragStart, startPos

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = button.Position
        originalPos = button.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        originalPos = button.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

print("✅ Đã load - Nút O nhỏ + ấn 2 lần + Fix chồng ngực")
]])()
